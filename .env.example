# Copy to .env.local (never commit .env.local), then restart `npm run dev`.

# Local database folder (PGlite). Optional; default is .data/pglite
# DATABASE_DIR=.data/pglite

# --- AI model provider ---
# Choose: anthropic (default) or ollama (for local free models)
# AI_PROVIDER=anthropic

# --- Option A: Anthropic Claude (hosted API) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults shown. Cheaper options: claude-sonnet-5-5, claude-haiku-4-5
# AI_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. "low" is right for short chat replies.
# AI_EFFORT=low

# --- Option B: Ollama (local, free, no API key needed) ---
# 1. Install Ollama from https://ollama.com
# 2. Run: ollama run qwen2.5:7b (or llama3.1:8b)
# 3. Set:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
