# Copy to .env.local (never commit .env.local), then restart `npm run dev`.

# Local database folder (PGlite). Optional; default is .data/pglite
# DATABASE_DIR=.data/pglite

# --- AI model provider ---
# Choose: anthropic (default) or ollama (for local free models)
# AI_PROVIDER=anthropic

# --- Option A: Anthropic Claude (hosted API) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults shown. Cheaper options: claude-sonnet-5-5, claude-haiku-4-5
# AI_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. "low" is right for short chat replies (fastest).
# AI_EFFORT=low
# Max output tokens (default 4000). Set higher if needed.
# AI_MAX_TOKENS=8000

# --- Option B: Ollama (local, free, no API key needed) ---
# 1. Install Ollama from https://ollama.com
# 2. Run: ollama run qwen2.5:7b (or llama3.1:8b)
# 3. Set:
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# --- Channel: Telegram Bot (Destination D10) ---
# Create a bot with @BotFather on Telegram and paste the token below:
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Optional secret token to verify incoming webhook requests (recommended in production):
# TELEGRAM_WEBHOOK_SECRET=your-random-secret-token

# --- Channel: Facebook Messenger & Instagram (Destination D11) ---
# Get Page Access Token from Meta Developer App -> Messenger -> Settings
# META_PAGE_ACCESS_TOKEN=EAAB...
# Verify token chosen by you when setting up the webhook callback in Meta App:
# META_VERIFY_TOKEN=alora-meta-secret
# App secret from Meta App Settings -> Basic (used to verify X-Hub-Signature-256):
# META_APP_SECRET=
# Optional: Instagram Graph API Access Token if separate from Page token
# INSTAGRAM_ACCESS_TOKEN=

# --- Channel: WhatsApp Cloud API (Destination D12) ---
# Meta Developer App -> WhatsApp -> API Setup:
# WHATSAPP_ACCESS_TOKEN=EAAB...
# WHATSAPP_PHONE_NUMBER_ID=100200300400500
# Verify token chosen by you in WhatsApp Configuration:
# WHATSAPP_VERIFY_TOKEN=alora-whatsapp-secret



