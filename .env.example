# Copy to .env.local (never commit .env.local), then restart `npm run dev`.

# Local database folder (PGlite). Optional; default is .data/pglite
# DATABASE_DIR=.data/pglite

# --- AI model (D2) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Defaults shown. Cheaper options: claude-sonnet-5-5, claude-haiku-4-5
# AI_MODEL=claude-opus-5-5
# Thinking depth: low | medium | high. "low" is right for short chat replies.
# AI_EFFORT=low
